{
  "name": "goose-index",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "sync": "tsx scripts/sync.ts",
    "verify": "tsx scripts/verify.ts",
    "capture-fixtures": "tsx scripts/capture-fixtures.ts",
    "backfill-slugs": "tsx scripts/backfill-slugs.ts",
    "bandcamp-known-ids": "tsx scripts/known-album-ids.ts",
    "scrape-bandcamp": "python3 scripts/scrape_bandcamp.py",
    "import-bandcamp": "tsx scripts/import-bandcamp.ts",
    "import-albums": "tsx scripts/import-albums.ts",
    "import-nugs": "tsx scripts/import-nugs.ts",
    "audit-source": "tsx scripts/audit-source.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.29",
    "postgres": "^3.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
